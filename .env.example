# Cloudflare API token, scoped to Zone:DNS:Edit on the two managed zones.
CLOUDFLARE_API_TOKEN=

# Async SQLAlchemy URL, e.g. postgresql+asyncpg://user:pass@db:5432/dns_switcher
DATABASE_URL=postgresql+asyncpg://dns_switcher:dns_switcher@db:5432/dns_switcher

# Shared secret checked against a header on requests from the AloBot container.
# Generate with: openssl rand -hex 32
INTERNAL_API_SHARED_SECRET=

LOG_LEVEL=INFO
